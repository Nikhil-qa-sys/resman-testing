# All environment files live in .env/. Shared defaults go in .env/.env
# (loaded first); env-specific overrides go in .env/.env.rc, .env/.env.qa,
# .env/.env.regression, .env/.env.support (all gitignored — never commit
# real creds).
# Select the active environment with: TEST_ENV=qa npx playwright test

BASE_URL=http://localhost:3000
TEST_USERNAME=
TEST_PASSWORD=
